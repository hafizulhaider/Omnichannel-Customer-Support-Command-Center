    {
      "parameters": {
        "jsCode": "const data = $input.item.json;\n\nconst supabaseUrl = ';\nconst supabaseKey = 'API';\n\nconst response = await this.helpers.request({\n  method: 'GET',\n  url: `${supabaseUrl}/rest/v1/tickets`,\n  qs: {\n    customer_channel_id: `eq.${data.customer_channel_id}`,\n    status: `in.(open,awaiting_customer,awaiting_agent)`,\n    select: 'id,status,source',\n    limit: 1\n  },\n  headers: {\n    'apikey': supabaseKey,\n    'Authorization': `Bearer ${supabaseKey}`\n  },\n  json: true\n});\n\nconst tickets = Array.isArray(response) ? response : [];\nconst existingTicket = tickets.length > 0 ? tickets[0] : null;\n\nreturn {\n  json: {\n    ...data,\n    existing_ticket_id: existingTicket ? existingTicket.id : null,\n    is_existing: existingTicket ? true : false\n  }\n};"
      },
