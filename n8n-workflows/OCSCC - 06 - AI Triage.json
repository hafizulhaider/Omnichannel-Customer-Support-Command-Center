        "options": {
          "systemMessage": "You are a customer support triage AI for a helpdesk system.\n\nAnalyze the customer message and respond ONLY with a valid JSON object. No extra text, no markdown, no code blocks. Just raw JSON.\n\nReturn exactly this structure:\n{\n  \"category\": \"billing|technical|general|complaint\",\n  \"priority\": \"high|medium|low\",\n  \"sentiment\": \"positive|neutral|negative\",\n  \"confidence\": <number between 0 and 100>,\n  \"ai_summary\": \"<one sentence summary of the issue>\",\n  \"ai_reply_draft\": \"<professional, empathetic reply to the customer>\"\n}",
          "maxIterations": 1
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        416,
        -96
      ],
      "id": "a9de025a-d6dc-4308-9c6e-980e56626042",
      "name": "AI Agent",
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "model": "nvidia/nemotron-3.5-lightning:free",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        416,
        144
      ],
      "id": "f67b439d-a993-4f40-95aa-30dffc80b94d",
      "name": "OpenRouter Chat Model",
      "credentials": {
        "openRouterApi": {
          "id": "ailvBTX7nKPBAFaz",
          "name": "Omnichannel"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const response = $input.item.json;\n\n// Handle rate limit or API errors\nif (response.error || !response.output) {\n  const buffer = $('read buffer').item.json;\n  return {\n    json: {\n      buffer_id: buffer.id,\n      source: buffer.source,\n      customer_name: buffer.customer_name,\n      customer_email: buffer.customer_email,\n      customer_phone: buffer.customer_phone,\n      customer_channel_id: buffer.customer_channel_id,\n      subject: buffer.subject,\n      body: buffer.body,\n      category: 'general',\n      priority: 'medium',\n      sentiment: 'neutral',\n      confidence: 0,\n      ai_summary: 'AI unavailable - manual review required',\n      ai_reply_draft: 'Thank you for contacting us. An agent will review your message shortly.',\n      sla_due_at: new Date(Date.now() + 4 * 60 * 60 * 1000).toISOString()\n    }\n  };\n}\n\nconst raw = response.output;\nconst cleaned = raw\n  .replace(/```json/gi, '')\n  .replace(/```/g, '')\n  .trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = {\n    category: 'general',\n    priority: 'medium',\n    sentiment: 'neutral',\n    confidence: 0,\n    ai_summary: 'Could not parse AI response',\n    ai_reply_draft: 'Thank you for contacting us. An agent will be with you shortly.'\n  };\n}\n\nconst buffer = $('read buffer').item.json;\n\nreturn {\n  json: {\n    buffer_id: buffer.id,\n    source: buffer.source,\n    customer_name: buffer.customer_name,\n    customer_email: buffer.customer_email,\n    customer_phone: buffer.customer_phone,\n    customer_channel_id: buffer.customer_channel_id,\n    subject: buffer.subject,\n    body: buffer.body,\n    category: parsed.category,\n    priority: parsed.priority,\n    sentiment: parsed.sentiment,\n    confidence: parsed.confidence,\n    ai_summary: parsed.ai_summary,\n    ai_reply_draft: parsed.ai_reply_draft,\n    sla_due_at: parsed.priority === 'high' \n      ? new Date(Date.now() + 1 * 60 * 60 * 1000).toISOString()\n      : parsed.priority === 'low'\n      ? new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString()\n      : new Date(Date.now() + 4 * 60 * 60 * 1000).toISOString()\n  }\n};"
      },
